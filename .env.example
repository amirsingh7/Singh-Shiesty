# Vitality Base runs with NO environment variables. Fork, deploy, done.
#
# OPTIONAL — cross-device sync + the Claude connector. Add your OWN free Supabase
# project's two PUBLIC keys (both are safe in the browser). From Supabase →
# Project Settings → API.
#   1. Create a free project at https://supabase.com
#   2. In its SQL editor run supabase/sync.sql (per-tile data) and, for the
#      connector, supabase/tiles.sql (tiles Claude builds for you)
#   3. Set these in Vercel → Settings → Environment Variables (and .env.local for
#      local dev), then redeploy
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED once you've signed up (supabase/auth_migration.sql) for the Claude
# connector and the Vitals ingest endpoint to keep working — neither has a
# browser login session, so they resolve "which account" from these instead.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (SECRET —
#   bypasses row-level security; never expose to the browser, never commit).
# OWNER_USER_ID: your account's id — after signing up, run in the SQL editor:
#   select id, email from auth.users order by created_at desc limit 5;
SUPABASE_SERVICE_ROLE_KEY=
OWNER_USER_ID=

# OPTIONAL — the Claude connector password (app/api/mcp). Any long random string.
# Without it the connector is disabled (returns 503). Never commit the real value.
MCP_TOKEN=

# OPTIONAL — password for the Vitals workout ingest endpoint (app/api/vitals/ingest).
# An iOS Shortcut sends this as "Authorization: Bearer <token>" after a workout ends.
# Without it the endpoint is disabled (503). Never commit the real value.
VITALS_INGEST_TOKEN=

# OPTIONAL — live-data keys. Each user adds their OWN free key — NEVER share one
# (a shared key hits its quota and gets revoked for everyone at once). TikTok
# needs NO key (keyless). Set these in .env.local for local dev and in Vercel
# → Environment Variables when live; they stay server-side and never reach the
# browser. Without them, YouTube/stock tiles just show "add a key" and manual
# entry still works.
#   YouTube subscribers → console.cloud.google.com → enable "YouTube Data API v3" → create API key
YOUTUBE_API_KEY=
#   Stock prices → https://finnhub.io → free signup → copy API key
FINNHUB_API_KEY=

# OPTIONAL — Spotify playback control (the Symphony tile). Your OWN Spotify
# Developer app, never a shared one. Set up:
#   1. https://developer.spotify.com/dashboard → Create app
#   2. Add Redirect URI: <your deployed domain>/api/spotify/callback
#      (and http://localhost:3000/api/spotify/callback for local dev)
#   3. Copy the Client ID and Client Secret below
# Without these, Symphony just shows a "Connect Spotify" button that won't work.
# Playback control (play/pause/skip/volume/device transfer) requires a
# Spotify Premium account — Spotify's API blocks those calls for Free accounts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Usually not needed in production (the deployed origin is detected
# automatically) — but `next dev` doesn't reliably reflect the host you're
# actually browsing on, so for local dev set this to match exactly what you
# registered above, e.g. http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REDIRECT_URI=

# OPTIONAL — powers two deliberate exceptions to this app's normal "no AI
# keys, ever" rule (everywhere else, intelligence runs in Claude Code, not
# the deployed app):
#   1. AI plausibility review on the Profile page (app/api/ai/review-pr) —
#      the "Ask AI" button on a flagged self-reported PR.
#   2. Gobind's live chat on the Mentor page (app/api/mentor/chat) — a real
#      inline reply instead of the free claude.ai handoff. Costs a fraction
#      of a cent per message on Sonnet.
# This is the platform's own operational key (not a per-user integration
# like YouTube/Finnhub above) — one key powers both features for every
# signed-up user on this deployment, so it's billed on YOUR account per
# message/review, not free. Get a key at https://console.anthropic.com →
# Settings → API Keys. Without it: flagged PRs just show the plain "large
# jump" flag with no "Ask AI" button, and Gobind's chat shows a "needs a key"
# message instead of replying.
ANTHROPIC_API_KEY=
